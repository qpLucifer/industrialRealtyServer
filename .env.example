# Industrial Realty API — copy to .env and adjust

PORT=3000
CORS_OPEN=true
ADMIN_ORIGIN=http://127.0.0.1:5173

# Admin JWT for /api/auth/login session (change in production)
ADMIN_JWT_SECRET=industrialRealty
# Session lifetime in seconds (60–31536000). Token payload `exp` and login `expiresAt` derive from this. Default: 7 days.
ADMIN_SESSION_TTL_SECONDS=3600

# MySQL (see scripts/schema.sql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=industrial_realty

# --- Aliyun OSS (required for POST /api/upload/oss) ---
# Region id e.g. oss-cn-hangzhou
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# Public URL prefix (CDN or https://bucket.oss-region.aliyuncs.com) — if empty, SDK return URL is used
OSS_PUBLIC_BASE_URL=
# Optional internal endpoint
# OSS_ENDPOINT=
