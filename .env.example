# Industrial Realty API — copy to .env and adjust

PORT=3000
CORS_OPEN=true
ADMIN_ORIGIN=http://127.0.0.1:5173

# Admin JWT for /api/auth/login session (required in NODE_ENV=production; min 16 chars, not example values)
ADMIN_JWT_SECRET=industrialRealty
# Session lifetime in seconds (60–31536000). Token payload `exp` and login `expiresAt` derive from this. Default: 7 days.
ADMIN_SESSION_TTL_SECONDS=3600

# Mini-program signed session (phone whitelist). Signing uses MINIAPP_JWT_SECRET if set, else ADMIN_JWT_SECRET, else a dev default.
# Verification tries MINIAPP_JWT_SECRET and ADMIN_JWT_SECRET (and the dev default) so mixed-env clusters still accept tokens.
# If you set MINIAPP_JWT_SECRET on one node, set the SAME value on every node that serves /api/* (or leave MINIAPP unset everywhere and use only ADMIN_JWT_SECRET).
MINIAPP_JWT_SECRET=
# Session lifetime in seconds (60–31536000). Default: 365 days unless overridden.
MINIAPP_SESSION_TTL_SECONDS=

# Production: phone-only mini login (POST /api/auth/mini-session, mini branch on /api/auth/login) is OFF unless set to true.
# Development: allowed by default. Production must use POST /api/auth/mini-wechat-phone.
ALLOW_MINI_PHONE_LOGIN=

# WeChat Mini Program — server-side exchange for getPhoneNumber code → POST /api/auth/mini-wechat-phone
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=

# Subscribe message template: 工作任务接受提醒 (thing1/name3/thing4/date5/thing6)
WECHAT_SUBSCRIBE_TEMPLATE_WORK_TASK=o-xUPUgSNctCXEpf1bMudPZtk40NieJgN0x8e-PJLtM
# formal | developer | trial
WECHAT_MINI_SUBSCRIBE_STATE=formal
# Scheduled: viewing 30min before start; follow on due day (Beijing), submitter only
SUBSCRIBE_SCHEDULER_ENABLED=true
SUBSCRIBE_SCHEDULER_INTERVAL_MS=60000
SUBSCRIBE_FOLLOW_REMIND_MIN_HOUR=8

# MySQL (see scripts/schema.sql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=industrial_realty
# Transient disconnect retry for pool.query / pool.execute (ECONNRESET, PROTOCOL_CONNECTION_LOST, etc.). Extra attempts after the first try; default 2.
MYSQL_QUERY_RETRY_ATTEMPTS=2
MYSQL_QUERY_RETRY_BASE_MS=30

# --- Tencent Cloud COS (required for POST /api/upload/oss) ---
# Region must be COS format (e.g. ap-guangzhou), not Aliyun oss-cn-*
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
# Bucket name as shown in COS console (often name-appid)
COS_BUCKET=
# Public URL prefix (custom CDN or https://{bucket}.cos.{region}.myqcloud.com)
COS_PUBLIC_BASE_URL=

# Mini-program share card token TTL in hours (default 72, max 720)
PROPERTY_SHARE_TTL_HOURS=72
